# 后端配置
PORT=8000
HOST=0.0.0.0

# Supabase配置（必须，用于上传文件到存储桶和保存记录到数据库）
# 在Supabase控制台 Settings > API 中获取
SUPABASE_URL=https://your-project.supabase.co
# 请使用 service_role key（服务角色密钥）而非anon key
SUPABASE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=
SUPABASE_BUCKET=detection-files
MODEL_WEIGHTS_BUCKET=model-weights

# 本地目录配置
UPLOAD_DIR=uploads
MODEL_DIR=models
RESULT_DIR=results
MODEL_CACHE_DIR=models/cache

# 默认权重配置
# 所有新用户将自动使用此默认权重，无需上传自己的模型
DEFAULT_MODEL_PATH=default/best.pt
DEFAULT_MODEL_NAME=默认停车位检测模型

# 文件大小限制（MB）
MAX_UPLOAD_SIZE_MB=200

# 并发检测数量
MAX_CONCURRENT_DETECTIONS=2
